# Railway Environment Variables Template
# Copy ONLY the variables relevant to each Railway service.
# Do not paste fake placeholders into production unchanged.

# ============================================================================
# SHARED VARIABLES (set on every service that needs them)
# Services: web, irc, bot
# ============================================================================
DATABASE_URL=postgresql://postgres:REPLACE_ME@YOUR-RAILWAY-HOST:PORT/railway
NODE_ENV=production

# Generate with: openssl rand -base64 32
WEBAPP_ENC_KEY=REPLACE_WITH_BASE64_32_BYTES

# Generate with: openssl rand -hex 16
IRC_ENCRYPTION_KEY=REPLACE_WITH_32_HEX_CHARS

IRC_MAX_MESSAGE_LENGTH=1000
IRC_RATE_LIMIT_MESSAGES=10
IRC_RATE_LIMIT_WINDOW=60000

# ============================================================================
# WEB SERVICE ONLY
# APP_ROLE must be web so Railway runs Next.js + migrations + seed.
# ============================================================================
APP_ROLE=web

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_WITH_BASE64_32_BYTES

# Use the actual public HTTPS URL of the web service.
# Example: https://web-production-xxxxx.up.railway.app
NEXTAUTH_URL=https://YOUR-WEB-SERVICE.up.railway.app

ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
ADMIN_EMAIL=admin@yourdomain.com

# Point to the BOT service public URL, not localhost.
# Example: https://bot-production-xxxxx.up.railway.app
BOT_BRIDGE_URL=https://YOUR-BOT-SERVICE.up.railway.app

# GitHub OAuth callback:
# https://YOUR-WEB-SERVICE.up.railway.app/api/auth/callback/github
GITHUB_CLIENT_ID=REPLACE_ME
GITHUB_CLIENT_SECRET=REPLACE_ME

# ============================================================================
# IRC SERVICE ONLY
# APP_ROLE must be irc so Railway runs the IRC TCP server.
# ============================================================================
APP_ROLE=irc
IRC_PORT=6667
IRC_HOSTNAME=irc.webrooster.it

# ============================================================================
# BOT SERVICE ONLY
# APP_ROLE must be bot so Railway runs the HTTP bridge bot.
# ============================================================================
APP_ROLE=bot

# Public URL of the web service used by the bot callbacks.
WEBAPP_HOST=https://YOUR-WEB-SERVICE.up.railway.app

# Internal/public host of the IRC service the bot must connect to.
# If Railway gives you an internal hostname for the irc service, prefer that.
IRC_SERVER_HOST=YOUR-IRC-SERVICE-HOST
IRC_SERVER_PORT=6667

# Optional. Defaults to Railway PORT.
# BOT_HTTP_PORT=4000

# ============================================================================
# NOTES
# ============================================================================
# 1. web, irc, and bot are three different Railway services.
# 2. The old localhost-based setup only works in local development.
# 3. MissingCSRF in the iframe usually means NEXTAUTH_URL/NEXTAUTH_SECRET/cookies
#    are not aligned with the real HTTPS web service.
# 4. "Authentication failed against database server" means DATABASE_URL is stale
#    or copied from an old Railway database instance.
# 5. Never commit real secrets to Git.
